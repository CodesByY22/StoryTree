generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id
  name           String
  email          String
  emailVerified  Boolean
  image          String?
  createdAt      DateTime
  updatedAt      DateTime
  
  // Onboarding fields
  username       String?   @unique
  displayName    String?
  bio            String?
  favoriteGenres String?
  preferences    Json?

  stories        Story[]
  likes          Like[]
  bookmarks      Bookmark[]
  
  followers      Follow[] @relation("Followers")
  following      Follow[] @relation("Following")
  comments       Comment[]
  notifications  Notification[] @relation("UserNotifications")
  notifiedBy     Notification[] @relation("ActorNotifications")
  readingHistory ReadingHistory[]

  Session        Session[]
  Account        Account[]

  @@unique([email])
  @@index([username])
  @@index([displayName])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

model Story {
  id          String      @id @default(uuid())
  title       String
  subtitle    String?
  content     String      @db.Text
  coverImage  String?
  genre       String?
  tags        String[]
  status      StoryStatus @default(DRAFT)
  
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]
  readingHistory ReadingHistory[]

  @@index([title])
  @@index([genre])
  @@index([status, publishedAt(sort: Desc)])
  @@map("story")
}

model Like {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("like")
}

model Bookmark {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("bookmark")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follow")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String
  storyId   String
  parentId  String?

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([storyId])
  @@index([authorId])
  @@index([parentId])
  @@map("comment")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  REPLY
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId    String
  actorId   String
  storyId   String?
  commentId String?

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notification")
}

model ReadingHistory {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  progress  Int      @default(0) // percentage 0-100
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("reading_history")
}
