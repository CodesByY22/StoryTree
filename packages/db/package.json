{
  "name": "@repo/db",
  "version": "1.0.0",
  "description": "StoryTree Collaborative Storytelling Platform",
  "author": "StoryTree Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StoryTree/StoryTree.git"
  },
  "keywords": [
    "storytree",
    "storytelling",
    "platform",
    "nextjs",
    "turborepo"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:small": "cross-env SEED_MODE=small tsx prisma/seed.ts",
    "seed:medium": "cross-env SEED_MODE=medium tsx prisma/seed.ts",
    "seed:large": "cross-env SEED_MODE=large tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.4.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.2"
  }
}
