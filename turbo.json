{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SEED_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": ["NEXT_PUBLIC_API_URL", "DATABASE_URL", "SENTRY_AUTH_TOKEN", "CI"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["SENTRY_AUTH_TOKEN", "CI"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["SENTRY_AUTH_TOKEN", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
